<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 et après : même chose (sauvegarde du téléphone et passage d'un téléphone à l'autre) -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
